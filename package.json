{
  "name": "utazasi",
  "version": "0.3.0",
  "private": true,
  "description": "Utazási — személyre szabott digitális útitárs (Villasimius, 2026.09.02–13.)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:supabase": "node --env-file=.env.local scripts/seed-supabase.mjs",
    "backup:runtime": "node --env-file=.env.local scripts/backup-runtime-data.mjs",
    "backup:runtime:scheduled": "node scripts/backup-runtime-scheduled.mjs",
    "backup:schedule": "node scripts/configure-runtime-backup-schedule.mjs",
    "backup:health": "node scripts/check-runtime-backup-health.mjs",
    "seed:supabase:dashboard-sql": "node scripts/generate-dashboard-seed-sql.mjs",
    "import:v19-regional": "node scripts/import-v19-regional-data.mjs",
    "report:route-candidates": "node scripts/report-route-candidates.mjs",
    "audit:place-coverage": "node --env-file=.env.local scripts/audit-place-coverage-mobility.mjs",
    "validate:intelligence": "node scripts/validate-destination-intelligence.mjs",
    "mobility:trip-base-links": "node --env-file=.env.local scripts/open-trip-base-route-links.mjs",
    "backfill:place-links": "node --env-file=.env.local scripts/backfill-canonical-place-links.mjs",
    "research": "node scripts/research.mjs",
    "research:live": "node --env-file=.env.local scripts/research.mjs live",
    "research:queue": "node scripts/research-coverage-queue.mjs",
    "research:full": "node --env-file=.env.local scripts/research/full-enrichment.mjs",
    "research:apply": "node scripts/research.mjs apply",
    "research:event": "node --env-file=.env.local scripts/research-event.mjs",
    "test:research": "node --test scripts/research/*.test.mjs",
    "test:gate0": "node --test scripts/gate0/*.test.mjs",
    "test:notebook": "node --test scripts/notebook/*.test.mjs",
    "test:timeline": "node --test scripts/timeline/*.test.mjs",
    "test:access": "node --no-warnings --experimental-strip-types --test scripts/access/*.test.mjs",
    "test:trip-base": "node --no-warnings --experimental-strip-types --test scripts/trip-base/*.test.mjs",
    "test:place-experience": "node --test scripts/place-experience/*.test.mjs",
    "test:place-facts": "node --no-warnings --experimental-strip-types --test scripts/place-facts/*.test.ts",
    "test:grounding": "node --no-warnings --experimental-strip-types --test scripts/grounding/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "0.400.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.4"
  }
}
