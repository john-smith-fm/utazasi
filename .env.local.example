# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local seed process only. Never expose or commit this value. New Supabase
# projects use an sb_secret_ key; the legacy variable remains a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated, local-only initial family access list. Do not commit real
# e-mail addresses. The provisioning script creates Auth users and memberships.
# Example: owner@example.com:owner,member@example.com:member
SUPABASE_FAMILY_MEMBERS=
SUPABASE_TRIP_SLUG=sardinia-family-2026
