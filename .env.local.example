# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local seed process only. Never expose or commit this value. New Supabase
# projects use an sb_secret_ key; the legacy variable remains a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the first family user created with Supabase Auth. Used only when
# assigning ownership to the canonical local seed data.
SUPABASE_SEED_USER_ID=
