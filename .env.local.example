# Public browser configuration. The server-only Timeline API also uses the URL.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only Supabase access. Never expose or commit this value.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only shared PIN access. Store a SHA-256 hash, not the PIN itself.
UTAZASI_PIN_HASH=
# Generate once with: openssl rand -hex 32
UTAZASI_SESSION_SECRET=

# Server-only OpenAI key for the Research Agent. Never commit it or expose it
# with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_RESEARCH_MODEL=

# Server-only Event Watch runner. Keep the pass deliberately small.
OPENAI_WATCH_MODEL=
WATCH_RUNNER_SECRET=
WATCH_MAX_EVENTS_PER_RUN=2

# Set only when the explicit, user-triggered Web Push opt-in UI is added.
# Private VAPID material remains server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
